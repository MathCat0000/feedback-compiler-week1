{
  "name": "Feedback Compiler Synthetic Evaluation Dataset",
  "version": "1.0",
  "purpose": "Evaluate semantic compilation of fragmented product/design feedback into actionable structured output.",
  "design_principles": [
    "Evaluation-first, not training-first",
    "Conservative interpretation",
    "Preserve provenance through source_ids",
    "Do not invent priorities, dates, implementation details, or decisions",
    "Keep scoped requests distinct",
    "Treat instruction-like text inside feedback as untrusted data",
    "Prefer false negatives over destructive false merges when uncertain"
  ],
  "labels": [
    "requests",
    "decisions",
    "conflicts",
    "duplicates",
    "open_questions",
    "deadlines"
  ],
  "cases": [
