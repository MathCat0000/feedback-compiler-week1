{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feedback-compiler-output-v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requests",
    "decisions",
    "conflicts",
    "duplicates",
    "open_questions",
    "deadlines",
    "notes"
  ],
  "properties": {
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/textWithSources"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/duplicate"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "deadlines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deadline"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "textWithSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "conflictItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "items"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/conflictItem"
          }
        }
      }
    },
    "duplicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "source_ids"
      ],
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_ids",
        "basis"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        },
        "basis": {
          "type": "string",
          "enum": [
            "explicit_missing_information",
            "ambiguity",
            "conflict",
            "inferred"
          ]
        }
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "related_request",
        "related_source_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "related_request": {
          "type": "string",
          "minLength": 1
        },
        "related_source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    }
  }
}
